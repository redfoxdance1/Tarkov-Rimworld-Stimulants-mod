<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>TCI_AcuteOverdose</defName>
    <label>acute stimulant overdose</label>
    <description>Severe stimulant toxicity. Pawn is unconscious and must be stabilized by a doctor. Without treatment, this condition is fatal.</description>
    <hediffClass>TarkovInjectors.Hediff_AcuteOverdose</hediffClass>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <initialSeverity>0.6</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>20</baseTendDurationHours>
      </li>
    </comps>
  </HediffDef>
  <HediffDef Class="TarkovInjectors.InjectorEffectDef">
    <defName>TCI_StimulantExhaustion</defName>
    <label>stimulant exhaustion</label>
    <description>After-effects of experimental pharmaceuticals.</description>
    <hediffClass>TarkovInjectors.Hediff_InjectorEffect</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <durationTicks>60000</durationTicks>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef Class="TarkovInjectors.InjectorEffectDef">
    <defName>TCI_ChemicalStrain</defName>
    <label>chemical strain</label>
    <description>After-effects of experimental pharmaceuticals.</description>
    <hediffClass>TarkovInjectors.Hediff_InjectorEffect</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>2</maxSeverity>
    <durationTicks>60000</durationTicks>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
