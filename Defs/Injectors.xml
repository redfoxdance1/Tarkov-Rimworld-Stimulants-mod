<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="TCI_InjectorBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <stackLimit>25</stackLimit>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <altitudeLayer>Item</altitudeLayer>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>60</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <WorkToMake>800</WorkToMake>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>TarkovInjectors/Morphine</texPath>
      <drawSize>(0.75,0.75)</drawSize>
    </graphicData>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
  </ThingDef>
  <ThingDef ParentName="TCI_InjectorBase">
    <defName>TCI_Morphine</defName>
    <label>morphine injector</label>
    <description>A single-use tactical injector. Effects last 6 in-game hours. Player ordered injection only; no recreational use.</description>
    <statBases>
      <WorkToMake>800</WorkToMake>
      <MarketValue>70</MarketValue>
    </statBases>
    <graphicData>
      <texPath>TarkovInjectors/Morphine</texPath>
    </graphicData>
    <comps>
      <li Class="TarkovInjectors.CompProperties_Injector">
        <effect>TCI_Effect_Morphine</effect>
      </li>
    </comps>
    <recipeMaker>
      <researchPrerequisite>TCI_Basic</researchPrerequisite>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <workSpeedStat>DrugProductionSpeed</workSpeedStat>
      <workSkill>Intellectual</workSkill>
      <soundWorking>Recipe_Drug</soundWorking>
    </recipeMaker>
    <costList>
      <Neutroamine>1</Neutroamine>
      <MedicineHerbal>1</MedicineHerbal>
    </costList>
  </ThingDef>
